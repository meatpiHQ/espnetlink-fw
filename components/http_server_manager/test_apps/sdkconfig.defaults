# Coding Standard rev 2.1 (§7): on-device test apps build against the MAIN
# firmware's partition table — no private fork. The `storage` littlefs
# partition (mounted by the filesystem component) comes from there.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../wican_pro_partitions_table.csv"
# Flash size matches the main firmware / WiCAN Pro hardware (16 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Loopback so the test app can HTTP itself on 127.0.0.1 without a network.
CONFIG_LWIP_NETIF_LOOPBACK=y
# PSRAM config matches the main firmware sdkconfig (WiCAN Pro S3: octal, 80 MHz).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Test-only override (Standard §7, sanctioned): the root defaults pin the
# 2 Mbaud console; the serial-capture harness reads at 115200.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
