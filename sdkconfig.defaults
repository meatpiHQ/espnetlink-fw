# Product chip (test_apps inherit this; the product sdkconfig pins it too)
CONFIG_IDF_TARGET="esp32s3"

# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Warnings stay warnings (matches the product sdkconfig; test_apps inherit).
# Needed since GCC 15 (IDF v6 toolchain): the vendored WireGuard/NaCl crypto
# (wireguard_lwip, microlink — byte-parity with WiCAN v6) uses exact-fit
# string initializers that trip -Werror=unterminated-string-initialization.
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# Product flash layout (PRODUCT.md): OTA slots + dedicated settings partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="espnetlink_partitions_table.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# USB Device (TinyUSB) - 2x CDC-ACM ports (LTE + GPS)
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2

# CherryUSB (device) - USB Ethernet + CDC console composite. The cherryusb
# component is VENDORED (components/cherryusb — meatpiHQ fork with the
# WiCAN-authored device-side CDC-NCM class); its ESP CMake branch hardcodes
# the device/host class enables, so no CHERRYUSB_DEVICE_CDC_* pins here.
# USB Ethernet class choice (usb_dev_ethernet Kconfig): CDC-NCM default —
# Windows' in-box UsbNcm.sys (Win11 24H2 removed RNDIS), native on
# macOS/Linux. RNDIS = legacy-Win10 option; ECM = macOS/Linux-only option
# (Win11 26200 bench-verified: NO in-box ECM driver).
CONFIG_CHERRYUSB=y
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_CHERRYUSB_DEVICE_SPEED_FS=y
CONFIG_CHERRYUSB_DEVICE_DWC2_ESP=y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM=y
CONFIG_CHERRYUSB_DEVICE_TEMPLATE_NONE=y
CONFIG_USBNET_CLASS_NCM=y

# PSRAM: 8MB embedded octal (AP_3v3) — MeatPi standard §2. Static data,
# task stacks, and reboot-surviving state default to PSRAM; memtest stays
# off because it would wipe .ext_ram_noinit on every boot.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32
CONFIG_SPIRAM_MEMTEST=n

# lwIP TCP performance tuning for LTE tethering
# The default 5760-byte window (4 × MSS) caps TCP throughput to ~450 kbps at
# 100 ms cellular RTT. Raising it to 32 KB allows ~2.6 Mbps at 100 ms RTT.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
# Deeper per-socket receive mailbox so back-to-back segments don't get dropped
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
# NAT + IP-forwarding path pushes the tcpip task stack; give it room
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# vpn_manager (Tailscale Noise handshake): ChaCha20-Poly1305 in mbedtls —
# off by default in mbedtls 4 (IDF v6); POLY1305_C is implied by CHACHAPOLY_C
# and no longer a kconfig symbol.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y

# dev_status task monitor (/api/status/tasks, system -t)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
